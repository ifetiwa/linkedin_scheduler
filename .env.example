# Copy to .env for local dev. In production set these in Render's dashboard.

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

# When true, no real LinkedIn calls are made (safe for dev)
DRY_RUN=false

# Set to "1" in production so the boot-time post-publishing thread runs.
# Leave at "0" locally — Flask debug-reload would restart the loop on every save.
ENABLE_SCHEDULER=0

# Override only in production (Render sets this via render.yaml to /var/data).
# DATA_DIR=

# Required for the daily Render cron job to call /api/cron/apply-jobs.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
